{
  "name": "artisan-uml-cli",
  "version": "0.5.0",
  "description": "Human-first class diagrams for agentic coding. Scan C# into an editable UML diagram, track human vs AI changes, scaffold back into code.",
  "type": "module",
  "bin": {
    "artuml": "bin/artuml.mjs"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "prepublishOnly": "node test/run.mjs"
  },
  "files": [
    "bin",
    "lib",
    "README.md"
  ],
  "dependencies": {
    "artisan-uml": "^1.2.1"
  },
  "editorContract": 2,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "uml",
    "class-diagram",
    "agentic",
    "ai",
    "opencode",
    "claude-code",
    "codex",
    "csharp",
    "unity",
    "scaffolding",
    "architecture"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscardelgado02/artisan-uml-cli.git"
  },
  "homepage": "https://cli.artisan-uml.dev/",
  "bugs": {
    "url": "https://github.com/oscardelgado02/artisan-uml-cli/issues"
  }
}
